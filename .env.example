# Skopiuj ten plik jako .env.dev i uzupełnij wartości. Plików .env* (poza tym wzorem) nie wrzucamy do repozytorium.

# Serwer HTTP
SERVER_PORT=2137

# Baza danych PostgreSQL
# Przy docker-compose.dev.yaml baza jest wystawiona na porcie 1000 komputera.
POSTGRES_HOST=localhost
POSTGRES_PORT=1000
POSTGRES_DB=kantor
POSTGRES_USER=kantor
POSTGRES_PASSWORD=change_me

# Tokeny sesji (JWT) – losowy ciąg min. 32 znaków, np. wynik: openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_EXPIRATION_MINUTES=60

# pgAdmin (tylko docker-compose.dev.yaml) – http://localhost:1100
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
